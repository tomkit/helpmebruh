{
  "name": "helpmebruh",
  "version": "0.1.0",
  "description": "An AI agent that lives in your iMessage. Runs on your Mac.",
  "license": "MIT",
  "homepage": "https://helpmebruh.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomkit/helpmebruh"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "eve dev",
    "build": "eve build",
    "bridge": "node --env-file-if-exists=.env bridge/bridge.mjs",
    "start": "eve start",
    "services:install": "scripts/services.sh install",
    "services:uninstall": "scripts/services.sh uninstall",
    "services:restart": "scripts/services.sh restart",
    "services:status": "scripts/services.sh status",
    "services:logs": "scripts/services.sh logs",
    "setup:secret": "node scripts/secret.mjs",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@composio/core": "^0.21.0",
    "agent-browser": "0.38.1",
    "ai": "^7.0.116",
    "eve": "0.67.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "microsandbox": "0.5.5",
    "typescript": "^7.0.2"
  }
}
