# Copy to .env and fill in. `pnpm run setup:secret` generates AGENT_SECRET.

# Shared secret between the bridge and the agent (any long random string).
AGENT_SECRET=

# Optional. New installs use the local ChatGPT/Codex subscription login.
# Set this only if you select Vercel AI Gateway in the admin page.
AI_GATEWAY_API_KEY=

# Optional. Set this only if you select Anthropic API in the admin page.
ANTHROPIC_API_KEY=

# Composio key for Gmail, Calendar and 1000+ other apps (optional).
COMPOSIO_API_KEY=
# Which Composio user your connected accounts belong to.
COMPOSIO_USER_ID=owner

# Where the bridge sends messages. Leave as is unless you change the port.
AGENT_URL=http://127.0.0.1:2000/imessage

# Everything else (trigger word, who can use it, models, tools) is set in the
# admin page at http://localhost:2000/admin. These are only first-run defaults:
TRIGGER=/bruh
REPLY_PREFIX=🤖
ALLOWED_SENDERS=
